# Copy to .env.local for local development, or set in the Vercel project settings.

# Which storage adapter the API uses.
#   memory — demonstration dataset held in the process (default). Not durable.
#   oracle — src/server/oracle-repository.ts (not implemented yet).
CP_DATA_DRIVER=memory

# ── Oracle, once the adapter is implemented ────────────────────────────────
# Fill in only the block matching the connection strategy you choose.

# Option A — ORDS / REST (recommended for Vercel serverless)
# ORACLE_ORDS_BASE_URL=https://<host>/ords/<schema>/
# ORACLE_ORDS_USERNAME=
# ORACLE_ORDS_PASSWORD=

# Option B — node-oracledb, direct TCP
# Needs a fixed egress IP (Vercel Secure Compute) or a proxy in front of the listener.
# ORACLE_USER=
# ORACLE_PASSWORD=
# ORACLE_CONNECT_STRING=<host>:<port>/<service_name>
# ORACLE_WALLET_LOCATION=
# ORACLE_WALLET_PASSWORD=
